{
  "name": "kb-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:development": "tsc -b && vite build --mode development",
    "build:production": "tsc -b && vite build --mode production",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint --fix .",
    "typecheck": "tsc -b",
    "test:watch": "vitest watch",
    "test:run": "vitest run",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@heroui/button": "^2.2.32",
    "@heroui/dropdown": "^2.3.32",
    "@heroui/input": "^2.4.33",
    "@heroui/system": "^2.4.28",
    "@heroui/theme": "^2.4.26",
    "@heroui/toast": "^2.0.22",
    "@hookform/resolvers": "^4.0.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-devtools": "^5.66.3",
    "@tanstack/react-table": "^8.21.3",
    "apexcharts": "^8.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "i18next": "^26.4.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.471.2",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-apexcharts": "^2.2.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^17.0.18",
    "react-router": "^8.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.4.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
